#!/bin/sh
# Drobot hybrid apps: mc + rover controllers + drobot state machine.
# Both controllers run simultaneously; drobot_att_control switches
# vehicle_type so the control allocator follows the active mode.

# --- Multicopter controllers ---
control_allocator start
mc_rate_control start
mc_att_control start
mc_hover_thrust_estimator start
flight_mode_manager start
mc_pos_control start

# --- Rover controller ---
rover_differential start

# --- Land Detector ---
land_detector start multicopter

# --- Drobot mode switch module ---
drobot_att_control start
